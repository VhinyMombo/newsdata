# syntax=docker/dockerfile:1.7
#
# Le Kiosque — frontend image: Vite build, served by nginx.
#
# nginx also reverse-proxies /api/* to the FastAPI container, mirroring the
# dev-server proxy in vite.config.js. That keeps the app single-origin in
# production too, so the browser never needs a CORS preflight and VITE_API_URL
# stays a relative path.

# ---------------------------------------------------------------- builder ---
FROM node:22-alpine AS builder

WORKDIR /app

# Lockfile-only layer: dependencies reinstall only when the lockfile moves.
COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# Baked into the bundle at build time (Vite inlines import.meta.env). The
# default is same-origin, which nginx proxies to the api service.
ARG VITE_API_URL=/api
ENV VITE_API_URL=$VITE_API_URL

RUN npm run build

# ---------------------------------------------------------------- runtime ---
FROM nginx:1.27-alpine AS runtime

RUN rm /etc/nginx/conf.d/default.conf
COPY nginx.conf /etc/nginx/conf.d/kiosque.conf
COPY --from=builder /app/dist /usr/share/nginx/html

# data.json is the ~20 MB embedding export regenerated by every pipeline run.
# Compose bind-mounts the live file over this path so refreshing the corpus
# doesn't mean rebuilding the image.
EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q --spider http://127.0.0.1/ || exit 1
