# Container-only overrides. Copy to .env.docker and edit.
#
# Loaded *after* .env, so anything set here wins. Secrets already in .env
# (VAPID_*, TAVILY_API_KEY) are picked up automatically — no need to repeat
# them. Values used for image build args (VITE_API_URL) must live in .env
# instead, since compose reads build-arg interpolation from .env only.

# --- Ollama ----------------------------------------------------------------
# Default: the host's Ollama, reached through host.docker.internal. On macOS
# this is the fast path — containers get no GPU access.
# Switch to the containerised one (docker compose --profile ollama up -d):
# OLLAMA_HOST=http://ollama:11434
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_EMBED_MODEL=embeddinggemma
OLLAMA_CHAT_MODEL=qwen3.5:9b
OLLAMA_NUM_CTX=16384

# --- Chat model (llm.py) -----------------------------------------------------
# ollama (default, local), gemini or groq. Embeddings stay on Ollama.
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# LLM_MODEL=gemini-2.5-flash
# Thinking off: faster answers, and fewer tokens against the free quota
# LLM_REASONING_EFFORT=none
# Tried when the first provider fails (free-tier quota exhausted, outage)
# LLM_FALLBACK_PROVIDER=groq
# GROQ_API_KEY=
# LLM_FALLBACK_MODEL=qwen/qwen3-32b
# LLM_FALLBACK_REASONING_EFFORT=none

# --- Public address (deploy/docker-compose.prod.yml) ------------------------
# Defaults to lekiosque.hodologic.fr. Compose interpolates it, so like
# VITE_API_URL it has to go in .env, not here.
# KIOSQUE_DOMAIN=lekiosque.hodologic.fr

# --- Published ports -------------------------------------------------------
# The API binds to 127.0.0.1 only; the frontend is the public entrypoint.
API_HOST_PORT=8000
WEB_HOST_PORT=8080
OLLAMA_HOST_PORT=11434

# --- Frontend build --------------------------------------------------------
# Same-origin by default: nginx proxies /api/* to the api service. Only change
# this if the API is served from a different host, and put it in .env.
# VITE_API_URL=/api

# --- Misc ------------------------------------------------------------------
TZ=Africa/Libreville

# --- Retrieval tuning (optional; api.py's own defaults shown) ---------------
# RELEVANCE_THRESHOLD=1.7
# CODES_RELEVANCE_THRESHOLD=1.9
# SIMILARITY_WEIGHT=0.6
# RECENCY_WEIGHT=0.4
# RECENCY_HALF_LIFE_DAYS=2.0
# OLLAMA_REASONING=false
