# Le Kiosque — public entrypoint. Caddy fetches and renews the certificate.

{$KIOSQUE_DOMAIN} {
	encode zstd gzip

	reverse_proxy web:80 {
		# /answer and the reports stream token by token
		flush_interval -1
		# api.py trusts cf-connecting-ip first for rate limiting; there is no
		# Cloudflare in front here, so a visitor must not be able to set it
		header_up -Cf-Connecting-Ip
	}
}

# The private rehearsal copy (deploy/staging.sh): nginx there asks for the password.
# A 502 here while it is stopped, without any effect on the live site.
staging.lekiosque.hodologic.fr {
	encode zstd gzip
	header X-Robots-Tag "noindex, nofollow"

	reverse_proxy staging-web:80 {
		flush_interval -1
		header_up -Cf-Connecting-Ip
	}
}

# Umami, the visitor statistics
{$STATS_DOMAIN} {
	encode zstd gzip
	reverse_proxy umami:3000
}
